<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:background="@drawable/bg_dialog_rounded">

    <!-- Icon -->
    <ImageView
        android:id="@+id/dialogIcon"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_circle_purple"
        android:padding="16dp"
        android:src="@drawable/ic_layers"
        app:tint="@android:color/white" />

    <!-- Title -->
    <TextView
        android:id="@+id/dialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Submit Leave"
        android:textColor="#000000"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <!-- Message -->
    <TextView
        android:id="@+id/dialogMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Double-check your leave details to ensure everything is correct. Do you want to proceed?"
        android:textColor="#666666"
        android:textSize="14sp"
        android:textAlignment="center"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <!-- Submit Button -->
    <Button
        android:id="@+id/buttonConfirm"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Yes, Submit"
        android:textColor="@android:color/white"
        android:textAllCaps="false"
        android:background="@drawable/btn_purple_rounded"
        android:layout_marginBottom="12dp" />

    <!-- Cancel Button -->
    <Button
        android:id="@+id/buttonCancel"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="No, Let me check"
        android:textColor="#7E5FF6"
        android:textAllCaps="false"
        android:background="@drawable/btn_purple_outline"
     />

</LinearLayout>
