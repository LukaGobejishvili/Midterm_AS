<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pressed -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#EFE9FF"/> <!-- Light pressed background -->
            <stroke android:width="2dp" android:color="#7E5FF6" />
            <corners android:radius="40dp"/>
        </shape>
    </item>

    <!-- Default -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/> <!-- Pure white background -->
            <stroke android:width="2dp" android:color="#7E5FF6" />
            <corners android:radius="40dp"/>
        </shape>
    </item>
</selector>
